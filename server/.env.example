# Copy to .env and fill in real values. Never commit .env — it is gitignored.
# For hosting (Render, Vercel, MongoDB Atlas) see docs/DEPLOYMENT.md.

# ---------------------------------------------------------------- core
PORT=5000
NODE_ENV=development
# Local default: mongodb://127.0.0.1:27017/school_management_system
# In production this is required (the server refuses to start without it).
MONGODB_URI=

# No demo data is ever created. On startup the server only makes sure a first
# admin login exists (when the database has no admin at all). In development it
# defaults to admin@gmail.com / admin; in production these are required
# (password at least 8 characters). Existing accounts are never modified.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Long random strings, different for each environment. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Websites allowed to call this API, comma-separated (no trailing slash).
# Localhost is always allowed outside production.
# CORS_ORIGINS=https://school.vercel.app,https://portal.yourschool.com

# The school's clock for "today" and the fee month (servers run on UTC).
# SCHOOL_TIMEZONE=Africa/Mogadishu

# Only if your network's DNS can't resolve mongodb+srv addresses:
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1

# ------------------------------------------------------------ ai assistant
# The assistant works WITHOUT a key: every data lookup is a database
# aggregation. A key only adds the narrative layer that phrases results in
# sentences. Leave blank to run the assistant in structured-results-only mode.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Optional. Defaults are the rolling "-latest" aliases, which are the most
# portable choice — available models vary by project, region and tier.
# Run `pnpm check:ai` to list what your key can actually use.
# AI_MODEL_ECONOMY=gemini-flash-latest
# AI_MODEL_ADVANCED=gemini-pro-latest
# AI_MAX_OUTPUT_ECONOMY=800
# AI_MAX_OUTPUT_ADVANCED=2000
# AI_REQUEST_TIMEOUT_MS=30000
# AI_RATE_MAX=60
# AI_CONVERSATION_TTL_DAYS=30
