# Copy to .env and fill in real values. Never commit .env — it is gitignored.

# ---------------------------------------------------------------- core
PORT=5000
NODE_ENV=development
MONGODB_URI=

# No demo data is ever created. On startup the server only makes sure a first
# admin login exists (when the database has no admin at all). In development it
# defaults to admin@gmail.com / admin; in production these are required
# (password at least 8 characters). Existing accounts are never modified.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Ask a teammate for these. Any long random string works for local dev.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ------------------------------------------------------------ ai assistant
# The assistant works WITHOUT a key: every Phase 1 data lookup is a database
# aggregation. A key only adds the narrative layer that phrases results in
# sentences. Leave blank to run the assistant in structured-results-only mode.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Optional. Defaults are the rolling "-latest" aliases, which are the most
# portable choice — available models vary by project, region and tier.
# Run `npm run check:ai` to list what your key can actually use.
# AI_MODEL_ECONOMY=gemini-flash-latest
# AI_MODEL_ADVANCED=gemini-pro-latest
# AI_MAX_OUTPUT_ECONOMY=800
# AI_MAX_OUTPUT_ADVANCED=2000
# AI_REQUEST_TIMEOUT_MS=30000
# AI_RATE_MAX=60
# AI_CONVERSATION_TTL_DAYS=30

# --------------------------------------------------------------- messaging
# Africa's Talking SMS gateway (currently stubbed — gatewayService only logs).
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
EMAIL_FROM=

# ----------------------------------------------------------------- library
LIBRARY_BORROW_DAYS=14
LIBRARY_FINE_RATE=0.5
