{
  "name": "sms-backend",
  "version": "1.0.0",
  "description": "School Management System Backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/",
    "bootstrap": "node src/seed/bootstrap.js",
    "db:reset": "node scripts/resetDatabase.js",
    "backfill:user-links": "node scripts/backfillUserLinks.js",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --passWithNoTests",
    "check:ai": "node scripts/checkAiProvider.js",
    "test:unit": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit --passWithNoTests",
    "test:integration": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand --detectOpenHandles --passWithNoTests",
    "backfill:student-class-sections": "node scripts/backfillStudentClassSections.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.1",
    "mongoose": "^8.24.0",
    "morgan": "^1.11.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZUST-ICT/school-management-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ZUST-ICT/school-management-backend/issues"
  },
  "homepage": "https://github.com/ZUST-ICT/school-management-backend#readme",
  "overrides": {
    "js-yaml": "^4.2.0"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "unrs-resolver"
    ]
  }
}
